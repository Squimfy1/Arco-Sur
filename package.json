{
  "name": "arco-sur",
  "version": "0.10.0",
  "description": "A testnet wallet for Arc that checks every payment before signing it.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "app": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build",
    "dev": "vite dev",
    "package": "vite build && electron-builder --mac dir --publish never -c.extraMetadata.arcoSurRoot=\"$PWD\"",
    "install-app": "npm run package && rm -rf ~/Applications/Cathedral.app && mkdir -p ~/Applications && cp -R dist/mac-arm64/Cathedral.app ~/Applications/",
    "test": "vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "send": "node src/lib/server/send.ts",
    "reconcile": "node src/lib/server/reconcile.ts",
    "balances": "node src/lib/server/read.ts"
  },
  "dependencies": {
    "viem": "2.58.2"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "build": {
    "appId": "app.cathedral.wallet",
    "productName": "Cathedral",
    "directories": {
      "output": "dist",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/main.js",
      "build/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "identity": null,
      "target": "dir",
      "icon": "electron/resources/icon.png"
    }
  }
}
