{
  // SvelteKit writes the base ($app/tsconfig) on `svelte-kit sync`: module
  // settings, $lib paths and the route types. Nothing here is compiled to
  // JavaScript: Node and Vite strip the types, tsc and svelte-check only
  // check them.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "node"],
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests", "*"],
  "exclude": ["src/service-worker"]
}
